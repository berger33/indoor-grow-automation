{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://indoor-grow.local/contracts/mqtt/ack-v1.schema.json",
  "title": "Indoor Grow Command ACK/NACK v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "sequence", "status", "reason", "handled_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "command_id": { "type": "string", "format": "uuid" },
    "sequence": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["ack", "nack"] },
    "reason": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$" },
    "handled_at": { "type": "string", "format": "date-time" }
  }
}
